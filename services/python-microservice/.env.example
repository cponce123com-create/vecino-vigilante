# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini (optional, for improved relationship extraction)
GEMINI_API_KEY=your_gemini_api_key

# Telegram Bot (create one via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_WEBHOOK_URL=https://your-domain.com  # Full URL where this microservice is deployed

# Node.js API URL (for forwarding processed data)
NODEJS_API_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
