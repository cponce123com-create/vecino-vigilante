# ═══════════════════════════════════════════════════════════════
# MÓDULO DE INVESTIGACIÓN
# ═══════════════════════════════════════════════════════════════
# URL del microservicio Python (NLP + Cloudinary)
# En local: http://localhost:8000
# En Render: se descubre automáticamente (service name)
PYTHON_MICROSERVICE_URL=http://localhost:8000

# Cloudinary (para subida de fotos de personas)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini API Key (opcional, mejora extracción de relaciones)
GEMINI_API_KEY=your_gemini_api_key
